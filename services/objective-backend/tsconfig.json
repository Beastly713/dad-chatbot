{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "types": ["jest", "node"],
        "paths": {
            "@dad-chatbot/objective-safety": [
                "../../packages/objective-safety/src/index.ts"
            ],
            "@dad-chatbot/objective-schemas": [
                "../../packages/objective-schemas/src/index.ts"
            ]
        }
    },
    "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
